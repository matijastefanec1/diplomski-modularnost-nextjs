{
  "name": "@splitscore/variant-a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"tests/architecture-fixtures/**\"",
    "typecheck": "tsc --noEmit",
    "unit": "vitest run --config vitest.config.ts",
    "coverage:evaluation:domain": "vitest run --coverage --config vitest.evaluation-domain.config.ts",
    "coverage:evaluation:status": "vitest run --coverage --config vitest.evaluation-status.config.ts",
    "test:architecture": "vitest run --config vitest.architecture.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:synthetic-data": "node --test scripts/synthetic-data.test.mjs",
    "seed": "node scripts/seed.mjs",
    "clean:preflight": "node scripts/clean.mjs",
    "clean": "node scripts/clean.mjs --apply",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "verify": "pnpm lint && pnpm test:architecture && pnpm typecheck && pnpm unit && pnpm prisma:generate && pnpm prisma:validate && pnpm build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-boundaries": "7.1.0",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
